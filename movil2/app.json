{
  "expo": {
    "name": "Domicilios Orito",
    "slug": "movil2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F1E6"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F1E6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.darwine.movil2",
      "permissions": ["POST_NOTIFICATIONS", "VIBRATE", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#185FA5"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Orito usa tu ubicacion para marcar de donde sales y calcular la tarifa."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4dff04b1-da23-42c3-9ccb-058e19f5ddce",
      "fallbackToCacheTimeout": 3000
    },
    "extra": {
      "eas": {
        "projectId": "4dff04b1-da23-42c3-9ccb-058e19f5ddce"
      }
    }
  }
}
